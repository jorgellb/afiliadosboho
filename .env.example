# --- Base de datos (Neon Postgres) ---
# Cadena de conexión de neon.tech (usa la variante "pooled" para serverless).
DATABASE_URL=

# --- Panel de administración ---
ADMIN_PASSWORD=
# Cadena aleatoria larga (ej.: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# --- Cron de Vercel ---
# Cadena aleatoria; Vercel la envía como "Authorization: Bearer <valor>".
CRON_SECRET=

# --- Caché (opcional): Upstash for Redis vía Vercel Marketplace (sucesor de Vercel KV) ---
# Si no se configuran, la app funciona sin caché.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Amazon Product Advertising API 5.0 ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Ajusta según el marketplace de tu cuenta de Associates:
# EE. UU.: webservices.amazon.com / us-east-1 / www.amazon.com
# España:  webservices.amazon.es  / eu-west-1 / www.amazon.es
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com
# SearchIndex de PA-API ("All" siempre es válido; "Fashion" en EE. UU.)
AMAZON_SEARCH_INDEX=All

# --- AliExpress Affiliate API (open platform) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Opcionales:
ALIEXPRESS_TARGET_CURRENCY=USD
ALIEXPRESS_TARGET_LANGUAGE=ES
# País de envío (código ISO-2, ej. US, ES); vacío = sin filtro
ALIEXPRESS_SHIP_TO=
