# --- Base de datos (Neon Postgres) ---
# Cadena de conexión de neon.tech (usa la variante "pooled" para serverless).
DATABASE_URL=

# --- URL pública del sitio ---
# Se usa en canónicas, sitemap, Open Graph y feed de Merchant Center.
# Si se deja vacía se cae a VERCEL_PROJECT_PRODUCTION_URL y, en local,
# a http://localhost:3000. En producción DEBE ser el dominio propio.
SITE_URL=https://bohochic.es

# --- Panel de administración ---
ADMIN_PASSWORD=
# Cadena aleatoria larga (ej.: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# --- Cron de Vercel ---
# Cadena aleatoria; Vercel la envía como "Authorization: Bearer <valor>".
CRON_SECRET=

# --- Caché (opcional): Upstash for Redis vía Vercel Marketplace (sucesor de Vercel KV) ---
# Si no se configuran, la app funciona sin caché.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Asistente de moda (API de NVIDIA, compatible con OpenAI) ---
NVIDIA_API_KEY=
# Opcionales:
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
# Cadena de reserva del asistente, separada por comas: se prueba en orden
# cuando el modelo principal falla o el endpoint gratuito está saturado.
NVIDIA_FALLBACK_MODELS=meta/llama-3.1-70b-instruct

# --- Encuentra este Look (búsqueda por imagen, coste cero) ---
# Clave para el endpoint interno de indexación por lotes (script + cron).
INTERNAL_API_KEY=
# Tope diario global de búsquedas para proteger la cuota gratuita de NIM.
MAX_DAILY_SEARCHES=300
# Tamaño del lote de indexación (bajo para caber en el timeout de Hobby).
EMBED_BATCH_SIZE=10
# Similitud coseno mínima para aceptar una coincidencia. Calibrado con datos
# reales de nv-embedqa-e5-v5: los aciertos caen en 0.50-0.65 y el ruido en
# 0.34-0.47. Dejar sin definir usa 0.48, que es el valor bueno.
MATCH_THRESHOLD=0.48
# La imagen del usuario NO se almacena (va como base64 al modelo y se descarta);
# el modelo de embeddings (nvidia/nv-embedqa-e5-v5, 1024 dim) usa NVIDIA_API_KEY.

# --- AliExpress Affiliate API (open platform) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Opcionales:
ALIEXPRESS_TARGET_CURRENCY=EUR
ALIEXPRESS_TARGET_LANGUAGE=ES
# País de envío (código ISO-2, ej. US, ES); vacío = sin filtro
ALIEXPRESS_SHIP_TO=
# Opcional: nombre del parámetro de sub-ID que tu portal de AliExpress lee para
# atribuir la venta al canal/página (ej. aff_fsk). Si se deja vacío, el enlace
# de salida no se modifica (la atribución interna por /go?src= funciona igual).
ALIEXPRESS_SUBID_PARAM=

# --- Vercel Deployment ---
VERCEL_TOKEN=

# --- Correo transaccional (Resend) ---
# Clave de API de resend.com. Sin ella, el sistema no envía correo (no falla).
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend.
EMAIL_FROM=Boho Chic <hola@bohochic.es>
# Buzón que recibe los avisos del sistema y las respuestas (Reply-To).
EMAIL_ADMIN=
# Red de seguridad: si se define, TODO el correo saliente se redirige aquí en
# lugar de al destinatario real. Vaciar para escribir de verdad a los usuarios.
EMAIL_OVERRIDE_TO=
