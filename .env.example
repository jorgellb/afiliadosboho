# --- Base de datos (Neon Postgres) ---
# Cadena de conexión de neon.tech (usa la variante "pooled" para serverless).
DATABASE_URL=

# --- Panel de administración ---
ADMIN_PASSWORD=
# Cadena aleatoria larga (ej.: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# --- Cron de Vercel ---
# Cadena aleatoria; Vercel la envía como "Authorization: Bearer <valor>".
CRON_SECRET=

# --- Caché (opcional): Upstash for Redis vía Vercel Marketplace (sucesor de Vercel KV) ---
# Si no se configuran, la app funciona sin caché.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Asistente de moda (API de NVIDIA, compatible con OpenAI) ---
NVIDIA_API_KEY=
# Opcionales:
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# --- Probador Boho Virtual ---
# El clasificador visual usa la cadena multimodal fija en lib/nvidia.ts
# (llama-4-maverick → minimax-m3 → nemotron-super-49b). Solo necesita NVIDIA_API_KEY.
# Fase actual (AR de accesorios): recorte de fondo en el navegador, sin coste ni claves.
# Fases futuras (try-on de ropa + looks compartidos), aún no activas:
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob para guardar fotos/resultados/looks
# FASHN_API_KEY=           # try-on generativo de ropa (proveedor primario)
# REPLICATE_API_TOKEN=     # try-on generativo de ropa (fallback IDM-VTON)
# REMOVEBG_API_KEY=        # recorte de fondo en servidor (alternativa a WASM en cliente)

# --- AliExpress Affiliate API (open platform) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Opcionales:
ALIEXPRESS_TARGET_CURRENCY=USD
ALIEXPRESS_TARGET_LANGUAGE=ES
# País de envío (código ISO-2, ej. US, ES); vacío = sin filtro
ALIEXPRESS_SHIP_TO=
# Opcional: nombre del parámetro de sub-ID que tu portal de AliExpress lee para
# atribuir la venta al canal/página (ej. aff_fsk). Si se deja vacío, el enlace
# de salida no se modifica (la atribución interna por /go?src= funciona igual).
ALIEXPRESS_SUBID_PARAM=
